# ─────────────────────────────────────────────────────────────────────────────
# ShieldScan AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real credentials to git.
# ─────────────────────────────────────────────────────────────────────────────

# Required for Gemini semantic / multimodal analysis
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Retrieval provider: lancedb (default, local/no account), local, or vertex
SHIELDSCAN_RETRIEVAL_PROVIDER=lancedb
SHIELDSCAN_LANCEDB_PATH=data/lancedb
SHIELDSCAN_LANCEDB_TABLE=threat_intel
SHIELDSCAN_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional Vertex AI Search provider
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_DATA_STORE_ID=your-data-store-id
VERTEX_SEARCH_SERVING_CONFIG=default_config
